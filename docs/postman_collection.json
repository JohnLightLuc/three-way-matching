{
  "info": {
    "name": "Rapprochement 3 voies — API",
    "_postman_id": "3way-matching-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API du moteur de rapprochement a 3 voies (ERP BTP).\n\nAUTH : Sanctum par token. Lance d'abord **Auth > Login (buyer)** — le token est stocke dans la variable de collection `token` et injecte en Bearer sur toutes les requetes. Pour la revue des ecarts, lance **Auth > Login (reviewer)** (variable `reviewerToken`, utilisee par le dossier *Revue*).\n\nPARCOURS type :\n1. Auth > Login (buyer)\n2. Referentiel > Lister fournisseurs / projets\n3. Bons de commande > Creer  (poId + poLineId sauvegardes)\n4. Bons de livraison > Enregistrer un DN\n5. Factures > Soumettre une facture  (invoiceId + invoiceLineId sauvegardes)\n6. Rapprochement > Declencher le rapprochement\n7. Rapprochement > File de revue  (decisionId sauvegarde)\n8. Revue > Approuver / Rejeter  (apres Login reviewer)\n\nLes variables d'ID sont chainees automatiquement par des scripts de test.\nbaseUrl par defaut : http://127.0.0.1:8000 (php artisan serve)."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "reviewerToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "supplierId",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "poId",
      "value": ""
    },
    {
      "key": "poLineId",
      "value": ""
    },
    {
      "key": "invoiceId",
      "value": ""
    },
    {
      "key": "invoiceLineId",
      "value": ""
    },
    {
      "key": "decisionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (buyer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"buyer@demo.test\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Renvoie { token, user }. Le token est stocke dans `token`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('token', j.token);",
                  "pm.collectionVariables.set('userId', j.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (reviewer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"reviewer@demo.test\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Token d'un utilisateur is_reviewer, stocke dans `reviewerToken` (dossier Revue)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('reviewerToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Revoque le token courant."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Referentiel",
      "item": [
        {
          "name": "Lister fournisseurs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/suppliers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "suppliers"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (Array.isArray(j) && j.length) pm.collectionVariables.set('supplierId', j[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Lister projets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "projects"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (Array.isArray(j) && j.length) pm.collectionVariables.set('projectId', j[0].id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bons de commande",
      "item": [
        {
          "name": "Lister (filtre statut)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/purchase-orders?status=open&per_page=20&page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "purchase-orders"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "open"
                },
                {
                  "key": "per_page",
                  "value": "20"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Creer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/purchase-orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "purchase-orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"PO-PM-{{$timestamp}}\",\n  \"supplier_id\": \"{{supplierId}}\",\n  \"project_id\": \"{{projectId}}\",\n  \"currency\": \"XOF\",\n  \"lines\": [\n    {\n      \"article_code\": \"CIM-425\",\n      \"description\": \"Ciment CPA 42.5 - sac 50 kg\",\n      \"unit\": \"sac\",\n      \"qty_ordered\": \"100.000\",\n      \"unit_price\": \"10.0000\"\n    },\n    {\n      \"article_code\": \"HA12\",\n      \"description\": \"Fer a beton HA 12 - barre\",\n      \"unit\": \"barre\",\n      \"qty_ordered\": \"50.000\",\n      \"unit_price\": \"7.5000\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "line_no auto-attribue si absent. Sauvegarde poId + poLineId (1re ligne)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('poId', d.id);",
                  "pm.collectionVariables.set('poLineId', d.lines[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consulter (etat + agregats)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/purchase-orders/{{poId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "purchase-orders",
                "{{poId}}"
              ]
            },
            "description": "Lignes avec qty_received / qty_matched / qty_available, DN et factures liees."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Bons de livraison",
      "item": [
        {
          "name": "Enregistrer un DN (60 recus)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/purchase-orders/{{poId}}/delivery-notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "purchase-orders",
                "{{poId}}",
                "delivery-notes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"DN-PM-{{$timestamp}}\",\n  \"received_at\": \"2026-08-20\",\n  \"notes\": null,\n  \"lines\": [\n    {\n      \"purchase_order_line_id\": \"{{poLineId}}\",\n      \"qty_received\": \"60.000\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "La ligne de PO doit appartenir a ce PO (sinon 422)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Factures",
      "item": [
        {
          "name": "Lister (filtre statut)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invoices?status=submitted&per_page=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "submitted"
                },
                {
                  "key": "per_page",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Soumettre une facture (100 @ 10)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/purchase-orders/{{poId}}/invoices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "purchase-orders",
                "{{poId}}",
                "invoices"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"INV-PM-{{$timestamp}}\",\n  \"supplier_id\": \"{{supplierId}}\",\n  \"invoice_date\": \"2026-08-25\",\n  \"lines\": [\n    {\n      \"purchase_order_line_id\": \"{{poLineId}}\",\n      \"article_code\": \"CIM-425\",\n      \"description\": \"Ciment CPA 42.5\",\n      \"qty_invoiced\": \"100.000\",\n      \"unit_price\": \"10.0000\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Fournisseur = celui du PO -> match sain. Sauvegarde invoiceId + invoiceLineId."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('invoiceId', d.id);",
                  "pm.collectionVariables.set('invoiceLineId', d.lines[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Soumettre une facture (ligne hors PO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/purchase-orders/{{poId}}/invoices",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "purchase-orders",
                "{{poId}}",
                "invoices"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"INV-OFFPO-{{$timestamp}}\",\n  \"supplier_id\": \"{{supplierId}}\",\n  \"invoice_date\": \"2026-08-25\",\n  \"lines\": [\n    {\n      \"purchase_order_line_id\": null,\n      \"article_code\": \"HORS-PO-X\",\n      \"description\": \"Article non commande\",\n      \"qty_invoiced\": \"5.000\",\n      \"unit_price\": \"3.0000\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "purchase_order_line_id null -> needs_review au rapprochement."
          },
          "response": []
        },
        {
          "name": "Consulter (etat de rapprochement)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices",
                "{{invoiceId}}"
              ]
            },
            "description": "Lignes + decision courante + autorisation de paiement + consommations FIFO."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Rapprochement",
      "item": [
        {
          "name": "Declencher le rapprochement",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/match",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoices",
                "{{invoiceId}}",
                "match"
              ]
            },
            "description": "Rapproche TOUTES les lignes de la facture (acteur = system). Idempotent."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('statut facture present', () => pm.expect(pm.response.json().data).to.have.property('status'));"
                ]
              }
            }
          ]
        },
        {
          "name": "File de revue (needs_review)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/match-decisions?status=needs_review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "match-decisions"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "needs_review"
                }
              ]
            },
            "description": "Decisions courantes needs_review produites par le moteur (actor_type=system)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const arr = pm.response.json().data;",
                  "if (arr.length) pm.collectionVariables.set('decisionId', arr[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Historique des decisions d'une ligne",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invoice-lines/{{invoiceLineId}}/decisions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "invoice-lines",
                "{{invoiceLineId}}",
                "decisions"
              ]
            },
            "description": "Chaine supersedes complete, la plus recente d'abord (is_current, actor_user)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Revue (reviewer)",
      "item": [
        {
          "name": "Approuver une decision",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/match-decisions/{{decisionId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "match-decisions",
                "{{decisionId}}",
                "review"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\",\n  \"note\": \"Ecart accepte apres verification\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewerToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Necessite Login (reviewer). Autorise le rapprochable au prix du PO."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Approuver avec quantite imposee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/match-decisions/{{decisionId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "match-decisions",
                "{{decisionId}}",
                "review"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approve\",\n  \"authorized_qty\": \"30.000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewerToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "authorized_qty <= rapprochable, sinon 422."
          },
          "response": []
        },
        {
          "name": "Rejeter une decision",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/match-decisions/{{decisionId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "match-decisions",
                "{{decisionId}}",
                "review"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"reject\",\n  \"note\": \"Ecart confirme, facture a corriger\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{reviewerToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Laisse la ligne non payee ; sort de la file de revue."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
